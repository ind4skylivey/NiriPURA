layout {

    focus-ring {
        active-color   "#bb2150"
        inactive-color "#ecdfe3"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#bb2150"
        inactive-color "#ecdfe3"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#bb2150"
        inactive-color "#e3abbc"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#bb215080"
    }
}

recent-windows {
    highlight {
        active-color "#bb2150"
        urgent-color "#fd4663"
    }
}
