layout {

    focus-ring {
        active-color   "#e467a1"
        inactive-color "#29141e"
        urgent-color   "#de5b97"
    }

    border {
        active-color   "#e467a1"
        inactive-color "#29141e"
        urgent-color   "#de5b97"
    }

    shadow {
        color "#29141e70"
    }

    tab-indicator {
        active-color   "#e467a1"
        inactive-color "#8d0c48"
        urgent-color   "#de5b97"
    }

    insert-hint {
        color "#e467a180"
    }
}

recent-windows {
    highlight {
        active-color "#e467a1"
        urgent-color "#de5b97"
    }
}
