layout {

    focus-ring {
        active-color   "#1a3995"
        inactive-color "#d8dff3"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#1a3995"
        inactive-color "#d8dff3"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#1a3995"
        inactive-color "#899dd8"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#1a399580"
    }
}

recent-windows {
    highlight {
        active-color "#1a3995"
        urgent-color "#fd4663"
    }
}
