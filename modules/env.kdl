// ============================================================
// modules/env.kdl
// Environment variables and cursor configuration for Wayland.
// ============================================================

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    XCURSOR_THEME "WhiteSur-cursors"
    XCURSOR_SIZE "24"
    GTK_CURSOR_THEME "WhiteSur-cursors"
    GTK_ICON_THEME "Papirus-Dark"
    // GTK_THEME removed 2026-10-28: it hard-forced "Adwaita:dark" on every
    // GTK app (including Firefox/Zen), defeating the clock-based
    // color-scheme scheduler. Apps now follow color-scheme.

    MOZ_ENABLE_WAYLAND "1"
    NIXOS_OZONE_WL "1"
    QT_QPA_PLATFORM "wayland"
    SDL_VIDEODRIVER "wayland,x11"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
}

cursor {
    xcursor-theme "WhiteSur-cursors"
    xcursor-size 24
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Allows notification actions and window activation from Noctalia
debug {
    honor-xdg-activation-with-invalid-serial
}

// Lid close: Noctalia locks and suspends
switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
}
