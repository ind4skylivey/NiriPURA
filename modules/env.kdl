// ============================================================
// modules/env.kdl
// Environment variables and cursor configuration for Wayland.
// ============================================================

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_STYLE_OVERRIDE "adwaita-dark"
    QT_STYLESHEET "/home/il1v3y/.config/pcmanfm-qt/sidebar-toolbar-dark.qss"
    XCURSOR_THEME "Bibata-Modern-Classic"
    XCURSOR_SIZE "24"
    GTK_CURSOR_THEME "Bibata-Modern-Classic"
    GTK_ICON_THEME "Papirus-Dark"
    GTK_THEME "Adwaita:dark"

    MOZ_ENABLE_WAYLAND "1"
    NIXOS_OZONE_WL "1"
    QT_QPA_PLATFORM "wayland"
    SDL_VIDEODRIVER "wayland"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Allows notification actions and window activation from Noctalia
debug {
    honor-xdg-activation-with-invalid-serial
}

// Lid close: Noctalia locks and suspends
switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
}
