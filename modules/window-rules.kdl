// ============================================================
// modules/window-rules.kdl
// Generic Noctara-Dots rules + translated from dwm Rule rules[].
// ============================================================

// --- Generics ---

window-rule {
    geometry-corner-radius 9
    clip-to-geometry true
    draw-border-with-background false
    opacity 0.975
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id=r#"firefox"# title="^Picture-in-Picture$"
    open-floating true
}

/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

// --- Noctalia: settings panel floating ---

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 850; }
    default-window-height { fixed 700; }
}

// --- Translated from dwm config.h Rule rules[] ---

window-rule {
    match app-id=r#"firefox$"#
    match app-id=r#"^Google-chrome$"#
    match app-id=r#"^Brave-browser$"#
    match app-id=r#"zen-alpha$"#
    match app-id=r#"^helium$"#
    open-on-workspace " web"
    background-effect {
        blur true
        xray true
    }
    open-maximized true
}

window-rule {
    match app-id=r#"^lutris$"#
    match app-id=r#"^steam_app_default$"#
    open-floating true
}

window-rule {
    match app-id=r#"^gamescope$"#
    open-fullscreen true
}

// --- Games launched via Faugus/umu (Proton): fullscreen ---
// Faugus runs games through umu-run + Proton under XWayland:
// every game window gets app-id "steam_app_default", so we
// match on the title. UE titles ship trailing spaces in it.
window-rule {
    match app-id=r#"^steam_app_default$"# title=r#"^Runescape: Dragonwilds\s*$"#
    open-fullscreen true
}

window-rule {
    match app-id=r#"^dolphin$"#
    match app-id=r#"(?i)^pcmanfm-qt$"#
    match app-id=r#"^Thunar$"#
    open-on-workspace " docs"
    open-floating true
    default-column-width { fixed 900; }
}

window-rule {
    match app-id=r#"^retroarch$"#
    match app-id=r#"^es-de$"#
    open-floating true
}

window-rule {
    match app-id=r#"^vesktop$"#
    match app-id=r#"^discord$"#
    match app-id=r#"^Legcord$"#
    open-on-workspace " chill"
}

window-rule {
    match app-id=r#"^BurpSuite$"#
    match app-id=r#"^Ghidra$"#
    match app-id=r#"^org\.owasp\.ZAP$"#
    open-on-workspace " sec"
}

window-rule {
    match app-id=r#"^Wireshark$"#
    open-on-workspace " sec"
}

window-rule {
    match app-id=r#"(?i)^(org\.pulseaudio\.)?pavucontrol$"#
    match app-id=r#"(?i)^blueman-(manager|adapters)$"#
    match app-id=r#"(?i)^nm-connection-editor$"#
    open-floating true
}

window-rule {
    match title=r#"^GtkFileChooserDialog$"#
    match title=r#"xdg-desktop-portal"#
    match title=r#"pop-up"#
    open-floating true
}

// --- Terminals: transparency + blur ---
window-rule {
    match app-id=r#"^Alacritty$"#
    background-effect {
        blur false
        xray true
    }
    opacity 0.97
}

// kitty without blur so the wallpaper stays sharp
window-rule {
    match app-id=r#"^kitty$"#
    background-effect {
        blur false
        xray true
    }
    opacity 0.97
}

// --- Video players: floating ---
window-rule {
    match app-id=r#"^mpv$"#
    match app-id=r#"^vlc$"#
    open-floating true
}

// --- Spotify: media workspace ---
window-rule {
    match app-id=r#"^spotify$"#
    open-on-workspace " chill"
}

// --- Thunderbird: chat workspace ---
window-rule {
    match app-id=r#"^thunderbird$"#
    match app-id=r#"^org\.mozilla\.Thunderbird$"#
    open-on-workspace " chill"
}

// --- IDEs: default column layout ---
window-rule {
    match app-id=r#"^zed$"#
    match app-id=r#"^dev\.zed\.Zed$"#
    match app-id=r#"^helix$"#
    default-column-width {}
}

// --- Proton VPN: floating ---
window-rule {
    match app-id=r#"^proton\.vpn\.app\.gtk$"#
    open-floating true
}

// --- ArchyNotch: borderless + floating ---
window-rule {
    match app-id="archynotch"
    border {
        off
    }
    open-floating true
}

// --- Juegos: mejor estado al jugar (2026-10-11) ---
// Native/Unity games pick "display 0" = the monitor at x=0,y=0 (vertical DP-2),
// so we send them to the "games" workspace (lives on DP-1, 180Hz).
// No opacity/blur/corners/clipping so niri can do direct scanout.
window-rule {
    match app-id=r#"^valheim\.x86_64$"#
    match app-id=r#"^steam_app_[0-9]+$"#
    match app-id=r#"^steam_app_default$"#
    match app-id=r#"^gamescope$"#
    open-on-output "DP-1"
    open-on-workspace " games"
    opacity 1.0
    variable-refresh-rate true
    geometry-corner-radius 0
    clip-to-geometry false
    background-effect {
        blur false
        xray false
    }
}

window-rule {
    match app-id=r#"^valheim\.x86_64$"#
    open-fullscreen true
}

// qBittorrent slightly transparent, with blur (Nightseed Transparent)
window-rule {
    match app-id=r#"^org\.qbittorrent\.qBittorrent$"#
    opacity 0.85
    background-effect {
        blur true
        xray true
    }
}

// ============================================================
// Style pack
// ============================================================

// 1. Glass: dark translucent apps with blur
window-rule {
    match app-id=r#"(?i)^org\.nicotine_plus\.Nicotine$"#
    match app-id=r#"(?i)^nicotine"#
    match app-id=r#"(?i)^spotify$"#
    match app-id=r#"(?i)^(dev\.sfg\.)?orchard$"#
    match app-id=r#"(?i)^(md\.)?obsidian$"#
    match app-id=r#"(?i)notesnook"#
    match app-id=r#"(?i)^emacs$"#
    match app-id=r#"(?i)^(dev\.zed\.)?zed$"#
    match app-id=r#"(?i)^cursor$"#
    match app-id=r#"(?i)^legcord$"#
    match app-id=r#"(?i)^heroic$"#
    match app-id=r#"(?i)faugus"#
    match app-id=r#"(?i)easyeffects"#
    opacity 0.9
    background-effect {
        blur true
        xray true
    }
}

// 2a. Video: solid, no blur (direct scanout in fullscreen)
window-rule {
    match app-id=r#"(?i)^mpv$"#
    match app-id=r#"(?i)^stremio"#
    match app-id=r#"(?i)nuvio"#
    opacity 1.0
    background-effect {
        blur false
        xray false
    }
}

// 2b. Art, audio and emulators: solid, true colors
window-rule {
    match app-id=r#"(?i)^krita$"#
    match app-id=r#"(?i)^gimp"#
    match app-id=r#"(?i)^blender$"#
    match app-id=r#"(?i)^ardour"#
    match app-id=r#"(?i)^eden$"#
    match app-id=r#"(?i)^dev\.eden_emu\.eden$"#
    match app-id=r#"(?i)^ryujinx$"#
    match app-id=r#"(?i)^lichii$"#
    match app-id=r#"(?i)^cheezyemu$"#
    match app-id=r#"(?i)^pcsx2"#
    match app-id=r#"(?i)duckstation"#
    match app-id=r#"(?i)^dolphin-emu$"#
    match app-id=r#"(?i)^retroarch$"#
    match app-id=r#"(?i)^es-de$"#
    match app-id=r#"(?i)^org\.es_de\.frontend$"#
    opacity 1.0
    background-effect {
        blur false
        xray false
    }
}

// 3. Paneles y utilidades: flotantes
window-rule {
    match app-id=r#"(?i)corectrl"#
    match app-id=r#"(?i)lact"#
    match app-id=r#"(?i)openrgb"#
    match app-id=r#"(?i)polychromatic"#
    match app-id=r#"(?i)solaar"#
    match app-id=r#"(?i)opentabletdriver"#
    match app-id=r#"(?i)flatseal"#
    match app-id=r#"(?i)protonplus"#
    match app-id=r#"(?i)goverlay"#
    match app-id=r#"(?i)^org\.kde\.kdeconnect"#
    match app-id=r#"(?i)voxtype"#
    match app-id=r#"(?i)cachyos-hello"#
    match app-id=r#"(?i)^org\.cachyos\.hello$"#
    match app-id=r#"(?i)kernelmanager"#
    match app-id=r#"(?i)scx-manager"#
    match app-id=r#"(?i)btrfs-assistant"#
    match app-id=r#"(?i)auto-cpufreq"#
    match app-id=r#"(?i)normcap"#
    match app-id=r#"(?i)lxqt-archiver"#
    match app-id=r#"(?i)^calibre-ebook-viewer$"#
    open-floating true
}

// 4. Secretos: en negro al compartir pantalla o capturar
window-rule {
    match app-id=r#"(?i)keepassxc"#
    match app-id=r#"(?i)proton-pass"#
    match app-id=r#"(?i)proton pass"#
    match app-id=r#"(?i)^exodus$"#
    match app-id=r#"(?i)feather"#
    match app-id=r#"(?i)seahorse"#
    block-out-from "screen-capture"
}

// 5. Workspaces per app
window-rule {
    match app-id=r#"(?i)^slack$"#
    match app-id=r#"(?i)whatsapp"#
    open-on-workspace " chill"
}
window-rule {
    match app-id=r#"(?i)dbeaver"#
    match app-id=r#"(?i)tableplus"#
    open-on-workspace "󰳆 dev"
}
window-rule {
    match app-id=r#"(?i)jadx"#
    open-on-workspace " sec"
}

// ============================================================
// App-to-workspace map (last, so it wins over earlier rules).
// Workspaces can move across monitors (Mod+Shift+Ctrl+H/J/K/L); apps follow them.
// ============================================================
window-rule {
    match app-id=r#"(?i)^kitty$"#
    open-on-workspace " term"
}
window-rule {
    match app-id=r#"(?i)^helium$"#
