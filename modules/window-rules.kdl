// ============================================================
// S1B workflow 2026-11-18: kitty-here / kitty-scratch / rmpc-float
// (distinct app-ids: the ^kitty$ -> term and ^rmpc$ -> chill rules don't match them)
// ============================================================
window-rule {
    match app-id=r#"^(kitty-here|kitty-scratch|rmpc-float)$"#
    background-effect {
        blur false
        xray true
    }
    opacity 0.97
}
window-rule {
    match app-id=r#"^kitty-scratch$"#
    open-floating true
    open-focused true
    default-column-width { fixed 1100; }
    default-window-height { fixed 650; }
    border {
        on
        width 2
        active-gradient from="#d04dff" to="#ff2d78" angle=135
        inactive-gradient from="#3a1a4a" to="#3a1a4a"
    }
}
window-rule {
    match app-id=r#"^rmpc-float$"#
    open-floating true
    open-focused true
    default-column-width { fixed 1000; }
    default-window-height { fixed 620; }
    border {
        on
        width 2
        active-gradient from="#00d4ff" to="#00d4ff"
        inactive-gradient from="#0a3a48" to="#0a3a48"
    }
}
