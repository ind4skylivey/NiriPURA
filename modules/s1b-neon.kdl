// ============================================================
// modules/s1b-neon.kdl — S1B neon window borders (2026-11-18)
// Included AFTER noctalia.kdl on purpose: noctalia.kdl is regenerated by the
// theme schedule and its *-color values would otherwise replace these gradients.
// Delete the include line in config.kdl to go back to noctalia's border colors.
// ============================================================
layout {
    border {
        active-gradient   from="#ff2d78" to="#00d4ff" angle=135 relative-to="workspace-view"
        inactive-gradient from="#1a0f1f" to="#1a0f1f"
        urgent-gradient   from="#00ff41" to="#00ff41"
    }
    tab-indicator {
        active-gradient   from="#d04dff" to="#00d4ff" angle=90
        inactive-gradient from="#3a1a4a" to="#3a1a4a"
        urgent-gradient   from="#00ff41" to="#00ff41"
    }
}
