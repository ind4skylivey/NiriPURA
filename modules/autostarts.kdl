// ============================================================
// modules/autostarts.kdl
// NIRI PURA + Noctalia v5 session. No Waybar, Dunst, Wofi, or Rofi.
// Noctalia handles: bar, notifications, launcher, control center,
// lockscreen, wallpaper picker. Replaces Waybar + Dunst + Wofi/Rofi entirely.
// ============================================================

// Wayland session bootstrap
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "systemctl" "--user" "import-environment" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
// Restart portal after Wayland env is imported (fixes KDE Connect Remote Input).
spawn-sh-at-startup "sleep 3 && systemctl --user restart xdg-desktop-portal hypr-kdeconnect-portal"
// NiriShift: repair xdg-desktop-portal after Gaming Mode round-trip
spawn-sh-at-startup "niri-shift-portal-recovery"

// Polkit agent
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"

// Noctalia -- full shell: bar, notifications, launcher, control center,
// lockscreen, wallpaper picker. Replaces Waybar + Dunst + Wofi/Rofi entirely.
// Pre-stop frees the unit name when orphaned processes from a previous
// session keep the old noctalia.scope alive (systemd-run would refuse to
// reuse the name and Noctalia would silently not start).
spawn-sh-at-startup "systemctl --user stop noctalia.scope 2>/dev/null; systemd-run --user --scope --unit=noctalia -p MemoryHigh=1G -p MemoryMax=2G -p MemorySwapMax=512M noctalia"

// Pin named workspaces to primary output (DP-1) after outputs settle.
// Fixes cold-boot case where they land on a secondary output (e.g. DP-2).
spawn-sh-at-startup "~/.config/niri/scripts/restore-named-workspaces.sh"


// swww-daemon removed: legacy from the pre-Noctalia stack. Nothing consumes
// it; Noctalia renders wallpapers and the video wallpaper uses mpvpaper.

// Slow services - start in background after session is ready
// Using spawn-sh-at-startup with & for background process
spawn-sh-at-startup "sleep 10 && (openrgb --startminimized &)"
// emacs runs as the systemd user service (emacs.service); no manual daemon
// spawn-sh-at-startup "emacs --daemon &"
spawn-sh-at-startup "solaar -w hide &"

// Fuzzel clipboard history daemon (fz-clip)
spawn-sh-at-startup "/home/il1v3y/.local/bin/fz-clip --watch &"

// Auto-lock after 5 minutes of inactivity
spawn-sh-at-startup "swayidle -w timeout 300 'noctalia msg session lock' resume 'notify-send \"Welcome back\"' &"

// Night light: gammastep auto cycle for Buenos Aires (6500K day / 3500K night)
spawn-sh-at-startup "$HOME/.config/niri/scripts/night-light.sh start"

// NOTE: waybar, dunst, rofi, and wofi are NOT started in this session.
// They remain only in your DWM (X11) session, untouched.

// Moved from XDG autostart (they raced the Wayland display; XDG copies set Hidden=true)
spawn-sh-at-startup "sleep 3 && blueman-applet"
spawn-sh-at-startup "sleep 3 && /usr/bin/kdeconnectd"
spawn-sh-at-startup "sleep 3 && keepassxc"
spawn-sh-at-startup "sleep 3 && pcmanfm-qt --daemon-mode"
spawn-sh-at-startup "sleep 5 && /usr/bin/terax"
spawn-sh-at-startup "sleep 5 && slack -s"
spawn-sh-at-startup "sleep 5 && easyeffects --hide-window --service-mode"
