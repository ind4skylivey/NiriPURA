// ============================================================
// File: ~/.config/niri/config.kdl
// Theme: Niri + Noctara-Dots (Peach/Coral Palette)
// Organization: S1BGroup / Livey Noir
// ============================================================

// --- Module Imports ---
include "./modules/input.kdl"
include "./modules/monitors.kdl"
include "./modules/env.kdl"
include "./modules/autostarts.kdl"
include "./modules/animations.kdl"
include "./modules/decorations.kdl"
include "./modules/layer-rules.kdl"
include "./modules/keybinds.kdl"
include "./modules/workspaces.kdl"
include "./modules/window-rules.kdl"

// --- Global Window Policy ---
// Visual consistency for all managed windows.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// --- Input Behavior ---
// This block must be separate from layout.
input {
    // Allows window focus to switch by moving the cursor.
    focus-follows-mouse
}

// --- Layout Configuration ---
layout {
    gaps 7

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.55; }

    // --- Theming & Focus Visualization ---
    focus-ring {
        width 4
        active-color   "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        width 2
        active-color   "#ffb59f" // Primary Coral
        inactive-color "#1c110e"
        urgent-color   "#ffb4ab"
    }

    tab-indicator {
        active-color   "#ffb59f"
        inactive-color "#b84622"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb59f80"
    }

    struts {
    }
}

// --- Cursor Settings ---
cursor {
    xcursor-theme "WhiteSur-cursors"
    xcursor-size 24
}

// --- UI Components ---
hotkey-overlay {
    skip-at-startup
}

// END OF FILE

include "noctalia.kdl"
