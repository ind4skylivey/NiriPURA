// ============================================================
// File: ~/.config/niri/config.kdl
// Theme: Niri + Noctara-Dots (Peach/Coral Palette)
// Organization: S1BGroup / Livey Noir
// ============================================================

// --- Module Imports ---
include "./modules/input.kdl"
include "./modules/monitors.kdl"
include "./modules/env.kdl"
include "./modules/autostarts.kdl"
include "./modules/animations.kdl"
include "./modules/decorations.kdl"
include "./modules/layer-rules.kdl"
include "./modules/keybinds.kdl"
include "./modules/workspaces.kdl"
include "./modules/window-rules.kdl"

// --- Global Window Policy ---
// Visual consistency for all managed windows.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// --- Layout Configuration ---
// Input behavior lives in modules/input.kdl (focus-follows-mouse, warp-mouse-to-focus).
layout {
    gaps 7

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.55; }

    // --- Theming & Focus Visualization ---
    // Focus is shown by the border below; focus-ring stays off (no double outline).
    focus-ring {
        off
    }

    // S1B neon (2026-11-18). Base colors; the gradients live in modules/s1b-neon.kdl,
    // included after noctalia.kdl so the theme can't override them.
    border {
        width 2
        active-color   "#ff2d78"
        inactive-color "#1a0f1f"
        urgent-color   "#00ff41"
    }

    tab-indicator {
        active-color   "#d04dff"
        inactive-color "#3a1a4a"
        urgent-color   "#00ff41"
    }

    insert-hint {
        color "#ffb59f80"
    }

    struts {
    }
}

// --- UI Components ---
// Cursor settings live in modules/env.kdl (WhiteSur-cursors, size 24).
hotkey-overlay {
    skip-at-startup
}

// END OF FILE

include "noctalia.kdl"

// S1B neon border gradients; must come after noctalia.kdl (see file header).
include "./modules/s1b-neon.kdl"

// Managed by the Noctalia niri-animations plugin. Must be LAST so the
// plugin can override the base animations from modules/animations.kdl.
include "./animations.kdl"
