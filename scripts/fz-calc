#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
# fz-calc - Calculator with live preview
# Group: s1bgr0up.inc
# Usage: fz-calc
# Type expression, see result in message banner, Enter copies result.
# ═══════════════════════════════════════════════════════════════════════

# Clean stale fuzzel lock
rm -f /run/user/$(id -u)/fuzzel-wayland-1.lock 2>/dev/null

while true; do
    # Prompt for expression; result shown as message
    expr=$(fuzzel --dmenu \
        --prompt="🧮 s1bgroup:~# " \
        --lines=0 \
        --placeholder="2+2, sqrt(16), 10*3.5..." \
        --mesg="Type a math expression. Enter = copy result, Esc = exit" \
        2>/dev/null)
    [ -z "$expr" ] && exit 0

    # Evaluate safely with bc
    result=$(echo "scale=4; $expr" | bc -l 2>/dev/null)
    if [ -z "$result" ] || ! echo "$result" | grep -qE '^[-0-9.]*$'; then
        # Try again with error message
        fuzzel --dmenu --prompt="🧮 s1bgroup:~# " --lines=0 \
            --mesg="❌ Invalid expression: $expr" \
            --placeholder="Try again..." >/dev/null 2>&1
        continue
    fi

    # Trim trailing zeros
    result=$(echo "$result" | sed 's/\.0*$//; s/\(\.*[0-9]*\)0*$/\1/')
    printf '%s' "$result" | wl-copy --type text/plain
    notify-send "fz-calc" "Result: $result (copied)" -i accessories-calculator
    exit 0
done
