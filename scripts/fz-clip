#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
# fz-clip - Clipboard history using fuzzel dmenu mode
# Group: s1bgr0up.inc
# Usage:
#   fz-clip            - show history, pick one to copy
#   fz-clip --watch    - daemon: capture clipboard to history
#   fz-clip --clear    - clear history
# ═══════════════════════════════════════════════════════════════════════

HISTORY_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/fz-clip/history"
MAX_ENTRIES=100

# Ensure history file exists, private to this user (may hold sensitive text)
umask 077
mkdir -p "$(dirname "$HISTORY_FILE")"
touch "$HISTORY_FILE"
chmod 700 "$(dirname "$HISTORY_FILE")"
chmod 600 "$HISTORY_FILE"

# Clean stale fuzzel lock (prevents "fuzzel already running" errors)
rm -f /run/user/$(id -u)/fuzzel-wayland-1.lock 2>/dev/null

# ── Daemon mode: capture clipboard ─────────────────────────────────────
if [ "$1" = "--watch" ]; then
    # Capture clipboard changes and append to history
    # Pass variables as args to avoid quoting issues
    wl-paste --watch bash -c '
        umask 077
        # Skip secrets: KeePassXC (and KDE apps) tag passwords with this MIME hint
        wl-paste -l 2>/dev/null | grep -qx "x-kde-passwordManagerHint" && exit 0
        content=$(wl-paste 2>/dev/null)
        [ -z "$content" ] && exit 0
        # Skip if identical to last entry
        last=$(tail -n 1 "$1" 2>/dev/null)
        [ "$content" = "$last" ] && exit 0
        # Skip if content is too long (avoid dumping files)
        [ ${#content} -gt 5000 ] && exit 0
        echo "$content" >> "$1"
        # Trim to MAX_ENTRIES
        tail -n "$2" "$1" > "$1.tmp" && mv "$1.tmp" "$1"
    ' _ "$HISTORY_FILE" "$MAX_ENTRIES"
    exit 0
fi

# ── Clear mode ─────────────────────────────────────────────────────────
if [ "$1" = "--clear" ]; then
    rm -f "$HISTORY_FILE"
    touch "$HISTORY_FILE"
    notify-send "fz-clip" "History cleared" 2>/dev/null
    exit 0
fi

# ── Main mode: show history, pick one ──────────────────────────────────
# Reverse history (newest first) and show preview of each entry
entries=$(tac "$HISTORY_FILE" 2>/dev/null | head -n "$MAX_ENTRIES")
[ -z "$entries" ] && {
    notify-send "fz-clip" "History is empty. Start daemon: fz-clip --watch" 2>/dev/null
    exit 0
}

# Show menu with truncated previews
selection=$(printf '%s\n' "$entries" | fuzzel --dmenu --prompt="📋 s1bgroup:~# " --lines=12)

# Exit if cancelled
[ -z "$selection" ] && exit 0

# Copy the full entry (not the truncated preview)
full_entry=$(grep -F -m 1 "$selection" "$HISTORY_FILE")
[ -z "$full_entry" ] && full_entry="$selection"

echo -n "$full_entry" | wl-copy
notify-send "fz-clip" "Copied to clipboard" 2>/dev/null