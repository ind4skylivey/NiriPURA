#!/bin/bash
# Lockscreen con imagen aleatoria de ~/Pictures/lockscreen (Noctalia lee ~/.cache/lockscreen-current)
# 2026-10-11: la carpeta se llama "lockscreen" (antes apuntaba a "screenlock", que no existe).
# Si no hay imágenes, igual bloquea (con la última imagen o el fondo por defecto).

LOCKSCREEN_DIR="$HOME/Pictures/lockscreen"
CURRENT_LOCK="$HOME/.cache/lockscreen-current"

RANDOM_IMAGE=$(find -L "$LOCKSCREEN_DIR" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) 2>/dev/null | shuf -n 1)

# Preview must not touch the saved image: check before copying
if [[ "$1" == "--dry-run" ]]; then
    echo "imagen: ${RANDOM_IMAGE:-ninguna}"
    exit 0
fi

if [[ -n "$RANDOM_IMAGE" ]]; then
    cp -f "$RANDOM_IMAGE" "$CURRENT_LOCK"
else
    echo "Sin imágenes en $LOCKSCREEN_DIR; bloqueo igual" >&2
fi
exec noctalia msg session lock
