#!/usr/bin/env python3
"""s1b-float-toggle — summon/dismiss a floating window by app-id (niri).

Usage: s1b-float-toggle APP_ID hide|close CMD [ARGS...]
  not running            -> spawn CMD
  running, focused       -> hide: park it on the empty workspace at the end of its monitor
                            close: close the window (e.g. rmpc; MPD keeps playing)
  running, not focused   -> bring it to the current workspace and focus it
"""
import json, subprocess, sys

def niri(*args, capture=False):
    r = subprocess.run(["niri", "msg", *args], text=True,
                       stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    return r.stdout if capture else r.returncode

def j(what):
    return json.loads(niri("-j", what, capture=True) or "null")

def main():
    if len(sys.argv) < 4 or sys.argv[2] not in ("hide", "close"):
        print(__doc__, file=sys.stderr); return 2
    app_id, mode, cmd = sys.argv[1], sys.argv[2], sys.argv[3:]
    wins = [w for w in j("windows") if w.get("app_id") == app_id]
    if not wins:
        subprocess.Popen(cmd, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    win = wins[0]
    wss = j("workspaces")
    cur = next(w for w in wss if w["is_focused"])
    if win.get("is_focused"):
        if mode == "close":
            niri("action", "close-window", "--id", str(win["id"]))
            return 0
        here = next(w for w in wss if w["id"] == win["workspace_id"])
        last = max((w for w in wss if w["output"] == here["output"]), key=lambda w: w["idx"])
        niri("action", "move-window-to-workspace", "--window-id", str(win["id"]),
             "--focus", "false", str(last["idx"]))
        return 0
    if win.get("workspace_id") != cur["id"]:
        ref = cur["name"] or str(cur["idx"])
        niri("action", "move-window-to-workspace", "--window-id", str(win["id"]),
             "--focus", "false", ref)
    niri("action", "focus-window", "--id", str(win["id"]))
    return 0

if __name__ == "__main__":
    sys.exit(main())
